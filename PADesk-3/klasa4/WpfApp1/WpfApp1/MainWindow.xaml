<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="35"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="60"/>
            <ColumnDefinition Width="200"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Liczba 1:" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5"/>
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Liczba 2:" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5"/>
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Działanie:" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5"/>
        <Button x:Name="btnOblicz" Content="Oblicz" Grid.Row="3" Grid.ColumnSpan="2" Width="100px" HorizontalAlignment="Left" Margin="5" Click="btnOblicz_Click"/>
        <TextBlock Grid.Row="4" Grid.Column="0" Text="Wynik:" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5"/>
        <TextBox x:Name="liczba1" Grid.Row="0" Grid.Column="1" Width="100" HorizontalAlignment="left" VerticalAlignment="Center"/>
        <TextBox x:Name="liczba2" Grid.Row="1" Grid.Column="1" Width="100" HorizontalAlignment="left" VerticalAlignment="Center"/>
        <ComboBox Name="comboBoxDzialanie" Grid.Row="2" Grid.Column="1" Width="100" HorizontalAlignment="Left" VerticalAlignment="Center">
            <ComboBoxItem Content="-" IsSelected="True"/>
            <ComboBoxItem Content="+"/>
            <ComboBoxItem Content="*"/>
            <ComboBoxItem Content="/"/>
        </ComboBox>
        <TextBox x:Name="textBlockResult" Grid.Row="4" Grid.Column="1" Text="" Width="200" VerticalAlignment="Center" HorizontalAlignment="Left"/>
    </Grid>
</Window>
