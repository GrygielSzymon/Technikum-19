<Window x:Class="WpfApp2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp2"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <StackPanel Margin="5">
        <StackPanel Orientation="Horizontal" Margin="5">
            <TextBlock Text="Bok a:" Width="70" VerticalAlignment="Center"/>
            <TextBox x:Name="txtA" Width="180"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="5">
            <TextBlock Text="Bok b:" Width="70" VerticalAlignment="Center"/>
            <TextBox x:Name="txtB" Width="180"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="5">
            <TextBlock Text="Oblicz:" Width="70" VerticalAlignment="Center"/>
            <ComboBox x:Name="cmbOblicz" Width="180">
                <ComboBoxItem Content="--Wybierz--" IsSelected="True"/>
                <ComboBoxItem Content="Pole"/>
                <ComboBoxItem Content="Obwód"/>
            </ComboBox>
        </StackPanel>

        <TextBlock x:Name="txtWynik" FontWeight="Bold"/>
    </StackPanel>
</Window>
